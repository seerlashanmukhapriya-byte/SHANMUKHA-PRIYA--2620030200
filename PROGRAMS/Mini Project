<!DOCTYPE html><html><head><link rel="stylesheet" href="dashboard.css"></head>
<body class="dashboard">
<header class="dashboard__header"><b>Logo</b><input placeholder="Search"><button class="btn" onclick="document.body.classList.toggle('dark')">Dark</button></header>
<aside class="dashboard__sidebar">Home | Profile</aside>
<main class="dashboard__main">
<div class="card"><h3 class="card__title">Users</h3><p>100</p></div>
<div class="card"><h3 class="card__title">Sales</h3><p>200</p></div>
<div class="card"><h3 class="card__title">Orders</h3><p>50</p></div>
<div class="card"><h3 class="card__title">Profit</h3><p>₹5000</p></div>
</main></body></html>
:root{--bg:white;--brand:rebeccapurple;--gap:1rem;--radius:10px;}
.dark{--bg:#222;--brand:gold;color:white;}
*{box-sizing:border-box;}
.dashboard{display:grid;grid-template-columns:200px 1fr;gap:var(--gap);}
.dashboard__header{grid-column:1/3;display:flex;justify-content:space-between;align-items:center;}
.dashboard__main{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--gap);}
.card{background:var(--bg);border:1px solid #ccc;border-radius:var(--radius);padding:1rem;transition:transform .3s;}
.card:hover{transform:scale(1.03);}
input:focus-visible{outline:3px solid gold;}
@media (max-width:768px){.dashboard{grid-template-columns:1fr;}.dashboard__header{grid-column:1;}.dashboard__main{grid-template-columns:1fr;}}
@media (prefers-reduced-motion:reduce){.card{transition:none;}}
